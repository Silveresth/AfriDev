# ── Backend (Django) ──
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DATABASE_URL=postgres://postgres:postgres@localhost:5432/afridev
REDIS_URL=redis://localhost:6379/0
PUBLIC_WEB_URL=http://localhost:3000

# IA : Groq (https://console.groq.com/keys). Sans clé, les fonctions IA sont désactivées.
GROQ_API_KEY=
# Modèles surchargeables si Groq fait évoluer son catalogue.
GROQ_SMART_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
AI_QUOTA_PER_DAY=50/day

# Embeddings (RAG). Sans clé : embedding local de secours, moins pertinent.
VOYAGE_API_KEY=

# Recherche tolérante aux fautes. Vide : repli sur PostgreSQL.
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_KEY=masterKey

# GitHub : jeton serveur (lecture des dépôts) + application OAuth (connexion).
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:3000/oauth/callback
# Google (console.cloud.google.com > Identifiants > ID client OAuth « Application Web »).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Appli mobile : GitHub / Google renvoient vers l'API, qui rebondit vers l'appli.
# URL de retour à déclarer chez le fournisseur : <API_PUBLIC_URL>/api/accounts/oauth/<github|google>/callback/
# Vide : déduite de la requête (http://<IP>:8000 en réseau local, https://… derrière un tunnel).
API_PUBLIC_URL=

# SMS (Africa's Talking). Sans clé : les SMS sont seulement journalisés.
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_USERNAME=sandbox
SMS_SENDER_ID=

PAYMENTS_PROVIDER_API_KEY=

# PowerSync. Clé privée RSA (PEM, \n échappés) obligatoire en production ;
# en dev, une clé est générée dans backend/.powersync_dev_key.pem.
POWERSYNC_URL=http://localhost:8080
POWERSYNC_JWT_PRIVATE_KEY=

# Médias et notifications
MEDIA_CDN_URL=
EXPO_ACCESS_TOKEN=

# ── Web (Next.js) ──
NEXT_PUBLIC_API_URL=http://localhost:8000
# Vide : pas de copie SQLite PowerSync (le web lit l'API et son cache local IndexedDB).
NEXT_PUBLIC_POWERSYNC_URL=
# Identifiants publics des applications OAuth (mêmes valeurs que GITHUB_CLIENT_ID / GITLAB_CLIENT_ID).
NEXT_PUBLIC_GITHUB_CLIENT_ID=
NEXT_PUBLIC_GITLAB_CLIENT_ID=
NEXT_PUBLIC_GITLAB_URL=https://gitlab.com

# ── Mobile (Expo) ──
# Vide en développement : l'appli vise automatiquement le PC qui sert Metro (port 8000).
# À renseigner pour un tunnel ou la production (ex. https://api.afridev.example).
EXPO_PUBLIC_API_URL=
# Vide : pas de copie SQLite PowerSync (le coffre se lit via l'API et son cache MMKV).
EXPO_PUBLIC_POWERSYNC_URL=http://10.0.2.2:8080
# Même application OAuth GitHub que le web ; y déclarer aussi l'URL de retour afridev://oauth.
EXPO_PUBLIC_GITHUB_CLIENT_ID=
# Adresse publique du site web : liens partagés depuis l'appli.
EXPO_PUBLIC_WEB_URL=http://localhost:3000
