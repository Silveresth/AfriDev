# ── Backend (Django) ──
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DATABASE_URL=postgres://postgres:postgres@localhost:5432/afridev
REDIS_URL=redis://localhost:6379/0
PUBLIC_WEB_URL=http://localhost:3000

# ── IA : Groq (https://console.groq.com/keys) ──
# Sans clé : réponses IA, tags, bio, traduction, résumé, reformulation, dictée vocale,
# guide d'onboarding et modération automatique sont désactivés (aucune tâche mise en file).
GROQ_API_KEY=
# Modèles surchargeables si Groq fait évoluer son catalogue (console.groq.com/docs/deprecations).
# Les Llama 3.x ont été retirés le 16/08/2026 : ne plus utiliser llama-3.3-70b-versatile / llama-3.1-8b-instant.
GROQ_SMART_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# Modèles à raisonnement : effort (low|medium|high) et jetons réservés à la réflexion.
GROQ_REASONING_EFFORT=low
GROQ_REASONING_BUDGET=512
# Cache des réponses identiques (secondes, 7 jours).
LLM_CACHE_SECONDS=604800
# Quota d'appels IA par utilisateur et durée max d'une tâche IA (secondes).
AI_QUOTA_PER_DAY=50/day
AI_TASK_SOFT_TIME_LIMIT=150

# Modération : analyse IA de chaque nouveau contenu, masquage auto au-delà de cette confiance,
# et nombre de signalements qui masquent un contenu en attendant un modérateur.
MODERATION_SCREEN_NEW_CONTENT=true
MODERATION_AI_HIDE_CONFIDENCE=0.9
MODERATION_AUTO_HIDE_REPORTS=3

# Embeddings (RAG, recherche par le sens, doublons) : https://dashboard.voyageai.com
# Sans clé : embedding local de secours, moins pertinent.
# Après avoir ajouté la clé ou changé de modèle : python manage.py reindex_knowledge
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5-lite
EMBEDDING_QUERY_CACHE_SECONDS=86400
SEMANTIC_SEARCH_QUOTA=120/hour

# Recherche tolérante aux fautes. Vide : repli sur PostgreSQL.
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_KEY=masterKey

# ── Connexion Google / GitHub (web ET mobile) ──
# Le fournisseur renvoie toujours vers l'API, qui rebondit vers le site (/oauth/callback) ou l'appli.
# UNE SEULE URL de retour à déclarer chez chaque fournisseur :
#   <API_PUBLIC_URL>/api/accounts/oauth/github/callback/
#   <API_PUBLIC_URL>/api/accounts/oauth/google/callback/
# Les boutons n'apparaissent que si l'ID ET le secret sont renseignés ici (aucune variable côté web).
API_PUBLIC_URL=
# GitHub : github.com/settings/developers > OAuth Apps (scopes demandés : read:user user:email).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Jeton serveur facultatif (lecture des dépôts publics, limite d'API relevée).
GITHUB_TOKEN=
# Google : console.cloud.google.com > API et services > Identifiants > ID client OAuth
# (type « Application Web ») ; écran de consentement : scopes openid, email, profile.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
# Ancien flux web direct (gardé pour compatibilité) : inutile avec le rebond par l'API.
OAUTH_REDIRECT_URI=http://localhost:3000/oauth/callback

# SMS (Africa's Talking). Sans clé : les SMS sont seulement journalisés.
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_USERNAME=sandbox
SMS_SENDER_ID=

PAYMENTS_PROVIDER_API_KEY=

# PowerSync. Clé privée RSA (PEM, \n échappés) obligatoire en production ;
# en dev, une clé est générée dans backend/.powersync_dev_key.pem.
POWERSYNC_URL=http://localhost:8080
POWERSYNC_JWT_PRIVATE_KEY=

# Médias : Cloudinary (envoi direct depuis le web/mobile, variantes et vidéo HLS produites par
# Cloudinary, rien de lourd sur le VPS). Vide : disque local (dev).
# console.cloudinary.com > Dashboard > « API environment variable » (bouton copier) :
CLOUDINARY_URL=
# … ou les trois valeurs séparées (Cloud name, API Key, API Secret) :
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=afridev
MEDIA_MAX_UPLOAD_MB=50
MEDIA_PRESIGN_EXPIRES=900

# E-mails (mot de passe oublié, notifications). Vide : affichés dans les journaux.
# Ex. Brevo : smtp+tls://<login>:<cle-smtp>@smtp-relay.brevo.com:587
EMAIL_URL=
DEFAULT_FROM_EMAIL=AfriDev Exchange <no-reply@afridev.dev>

# ── Notifications push ──
# Mobile (Expo → FCM/APNs). Jeton facultatif (expo.dev > Access tokens) si la sécurité
# renforcée des push est activée sur le projet EAS.
# Android : créer un projet Firebase, télécharger google-services.json et le fournir au build
# (secret EAS de type fichier GOOGLE_SERVICES_JSON), puis téléverser la clé de compte de
# service FCM V1 dans expo.dev > Credentials. iOS : clé APNs gérée par EAS.
EXPO_ACCESS_TOKEN=
# Web (navigateurs, Web Push / VAPID) : générer UNE fois avec
#   python manage.py generate_vapid_key
# puis ne plus la changer (sinon tous les navigateurs sont désabonnés). Vide : pas de push web.
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_SUBJECT=mailto:contact@afridev.dev

# ── Web (Next.js) ──
NEXT_PUBLIC_API_URL=http://localhost:8000
# Vide : pas de copie SQLite PowerSync (le web lit l'API et son cache local IndexedDB).
NEXT_PUBLIC_POWERSYNC_URL=
# (Plus besoin de NEXT_PUBLIC_*_CLIENT_ID : la connexion OAuth passe par l'API.)

# ── Mobile (Expo) ──
# Vide en développement : l'appli vise automatiquement le PC qui sert Metro (port 8000).
# À renseigner pour un tunnel ou la production (ex. https://api.afridev.example).
EXPO_PUBLIC_API_URL=
# Vide : pas de copie SQLite PowerSync (le coffre se lit via l'API et son cache MMKV).
EXPO_PUBLIC_POWERSYNC_URL=http://10.0.2.2:8080
# Adresse publique du site web : liens partagés depuis l'appli.
EXPO_PUBLIC_WEB_URL=http://localhost:3000
